# Copiez ce fichier en .env (local) et reportez les mêmes valeurs dans
# Vercel → Settings → Environment Variables (Production ET Preview).

# --- Client (exposées au navigateur, non secrètes) ---
VITE_SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"
VITE_SUPABASE_PROJECT_ID="VOTRE-REF-PROJET"

# --- Serveur (SSR / server functions) ---
SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# SECRET — jamais préfixé par VITE_, jamais commité
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxx"
